# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/stocky_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=stocky_db
DATABASE_USER=stocky_user
DATABASE_PASSWORD=stocky_password

# Server Configuration
PORT=3000
NODE_ENV=development

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=1000

# Stock Price Service
STOCK_PRICE_FETCH_INTERVAL_HOURS=1

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# External APIs (for future use)
NSE_API_URL=https://api.nse.com
BSE_API_URL=https://api.bse.com
